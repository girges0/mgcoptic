{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/gift(.*)", "destination": "/index.html$1" },
    { "source": "/learn(.*)", "destination": "/learn.html$1" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/signup", "destination": "/signup.html" },
    { "source": "/welcome", "destination": "/welcome.html" }
  ]
}